{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": ["fra1"],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,.codex/**,.env*,*.db}"
    }
  }
}
